<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>CardCargo Bunjang Orders</title>
  <style>
    body { font: 14px system-ui,sans-serif; width: 350px; padding: 16px; margin: 0; }
    h1 { font-size: 17px; margin: 0 0 8px; }
    p { line-height: 1.4; }
    button { width: 100%; padding: 11px; font-weight: 650; cursor: pointer; }
    #status { margin-top: 12px; line-height: 1.4; min-height: 40px; }
    small { opacity: .72; }
  </style>
</head>
<body>
  <h1>CardCargo Bunjang Order Extractor</h1>
  <p>
    Öffne die Bunjang-Kaufübersicht. Der Extractor findet die Bestelllinks und lädt die
    Detailseiten automatisch.
  </p>
  <button id="scan" type="button">Geladene Bestellungen scannen</button>
  <div id="status" role="status"></div>
  <small>Keine Cookies, Passwörter oder Tokens werden exportiert.</small>
  <script src="popup.js"></script>
</body>
</html>
