# Public values used by browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Never prefix this key with NEXT_PUBLIC_ and never commit .env.local.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Required single-user allowlist. Must match the Supabase Auth user and seed.sql.
ALLOWED_USER_EMAIL=you@example.com
NEXT_PUBLIC_APP_NAME=CardCargo

# Experimental image detection. Server-only; never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=sk_REPLACE_ME
OPENAI_VISION_MODEL=gpt-5-mini

# Inventory v1: optional Pokémon TCG API fallback
# TCGdex is used first and requires no key. Leave this blank to use the fallback unauthenticated.
POKEMON_TCG_API_KEY=
